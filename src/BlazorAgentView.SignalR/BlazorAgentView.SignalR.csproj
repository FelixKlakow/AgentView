<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet package metadata -->
    <PackageId>BlazorAgentView.SignalR</PackageId>
    <Version>1.0.0</Version>
    <Authors>Felix Klakow</Authors>
    <Description>SignalR integration for BlazorAgentView — hub constants and helpers for streaming AI agent messages over a real-time SignalR connection.</Description>
    <PackageTags>blazor;ai;chat;agent;signalr;streaming;real-time;blazor-server;dotnet10;component-library</PackageTags>
    <PackageProjectUrl>https://github.com/FelixKlakow/BlazorAgentView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FelixKlakow/BlazorAgentView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2026 Felix Klakow</Copyright>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <ProjectReference Include="../BlazorAgentView/BlazorAgentView.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Include README and icon in the NuGet package -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>
</Project>
