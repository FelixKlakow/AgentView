@inject IServiceProvider Services

<div class="bav-message bav-message-@(Message.Role.ToString().ToLower())">
    @if (ShowHeader)
    {
        <div class="bav-message-header">
            @if (EffectiveRoleLabel != string.Empty)
            {
                <span class="bav-message-role">@EffectiveRoleLabel</span>
            }
            @if (EffectiveShowTimestamp)
            {
                <span class="bav-message-timestamp">@Message.Timestamp.LocalDateTime.ToString("HH:mm")</span>
            }
        </div>
    }
    <div class="@BubbleClass">
        @if (Message.CustomContent != null)
        {
            @Message.CustomContent
        }
        else if (Options.EnableMarkdown && !string.IsNullOrEmpty(Message.Content))
        {
            <div class="bav-markdown-content">@Renderer.Render(Message.Content)</div>
        }
        else if (!string.IsNullOrEmpty(Message.Content))
        {
            <div class="bav-text-content">@Message.Content</div>
        }

        @if (Message.IsStreaming)
        {
            <span class="bav-streaming-indicator">
                <span class="bav-dot"></span><span class="bav-dot"></span><span class="bav-dot"></span>
            </span>
        }
    </div>
    @foreach (var toolCall in Message.ToolCalls)
    {
        <ToolCallView ToolCall="toolCall" OnCancelTool="OnCancelTool" ToolContentTemplate="ToolContentTemplate" Options="Options" />
    }
</div>

@code {
    // Shared fallback so consumers don't have to register IMarkdownRenderer
    // unless they want to swap the implementation.
    private static readonly DefaultMarkdownRenderer _defaultRenderer = new();

    [Parameter, EditorRequired] public ChatMessage Message { get; set; } = default!;
    [Parameter] public AgentChatOptions Options { get; set; } = new();
    [Parameter] public EventCallback<string> OnCancelTool { get; set; }
    [Parameter] public RenderFragment<ToolCall>? ToolContentTemplate { get; set; }

    private IMarkdownRenderer Renderer =>
        (IMarkdownRenderer?)Services.GetService(typeof(IMarkdownRenderer)) ?? _defaultRenderer;

    private bool IsAssistant => Message.Role == MessageRole.Assistant;

    private string BubbleClass => (IsAssistant && !Options.EnableAssistantBubble)
        ? "bav-bubble-plain"
        : "bav-bubble";

    // Resolve the label: null → default, "" → hidden
    private string EffectiveRoleLabel =>
        Message.RoleLabel is not null ? Message.RoleLabel : GetDefaultRoleLabel();

    private bool EffectiveShowTimestamp =>
        Message.ShowTimestamp ?? Options.ShowTimestamps;

    // Show the header row only when at least one piece of info is visible
    private bool ShowHeader =>
        EffectiveRoleLabel != string.Empty || EffectiveShowTimestamp;

    private string GetDefaultRoleLabel() => Message.Role switch
    {
        MessageRole.User => "You",
        MessageRole.Assistant => "Agent",
        MessageRole.System => "System",
        MessageRole.Tool => "Tool",
        _ => Message.Role.ToString()
    };
}
