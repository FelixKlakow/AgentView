<span class="bav-state-indicator bav-state-@(State.ToString().ToLower())" role="img" aria-label="@StateLabel">
    @switch (State)
    {
        case ToolState.Success:
            <svg class="bav-state-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            break;
        case ToolState.Failed:
            <svg class="bav-state-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
            </svg>
            break;
        case ToolState.Cancelled:
            <svg class="bav-state-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.6" fill="none" />
                <path d="M4.5 4.5l7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            break;
        case ToolState.Pending:
        case ToolState.Running:
        default:
            <span class="bav-state-dots" aria-hidden="true">
                <span class="bav-state-dot"></span>
                <span class="bav-state-dot"></span>
                <span class="bav-state-dot"></span>
            </span>
            break;
    }
</span>

@code {
    [Parameter, EditorRequired] public ToolState State { get; set; }

    private string StateLabel => State switch
    {
        ToolState.Pending => "Pending",
        ToolState.Running => "Running",
        ToolState.Success => "Succeeded",
        ToolState.Failed => "Failed",
        ToolState.Cancelled => "Cancelled",
        _ => State.ToString()
    };
}
