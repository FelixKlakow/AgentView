<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentView.Wpf</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AgentView.Wpf</PackageId>
    <Version>0.2.1</Version>
    <Authors>Felix Klakow</Authors>
    <Description>Native WPF agent-conversation chat view: user/assistant/system/tool messages, collapsible tool-call cards with live-updating state, markdown rendering, dark and light themes.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/FelixKlakow/AgentView</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FelixKlakow/AgentView</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>wpf;chat;agent;ai;markdown;conversation</PackageTags>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2026 Felix Klakow</Copyright>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentView.Wpf.Tests" />
  </ItemGroup>

</Project>
