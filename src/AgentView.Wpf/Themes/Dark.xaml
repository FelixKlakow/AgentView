<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AgentView.Wpf">

    <!-- Dark defaults; override any key (see AgentViewResourceKeys) to re-theme. -->
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.BackgroundBrushKey}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.SurfaceBrushKey}" Color="#2B2B2B" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.SurfaceStrongBrushKey}" Color="#333333" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.BorderBrushKey}" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.AccentBrushKey}" Color="#4F8EF7" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.TextBrushKey}" Color="#E8E8E8" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}" Color="#9A9A9A" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.SuccessBrushKey}" Color="#3E9B4F" />
    <SolidColorBrush x:Key="{x:Static local:AgentViewResourceKeys.ErrorBrushKey}" Color="#D9534F" />
    <FontFamily x:Key="{x:Static local:AgentViewResourceKeys.MonospaceFontFamilyKey}">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
