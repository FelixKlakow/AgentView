<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AgentView.Wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AgentView.Wpf;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="AgentView.BoolToVisibility" />
    <local:StringToVisibilityConverter x:Key="AgentView.StringToVisibility" />
    <local:RoleLabelConverter x:Key="AgentView.RoleLabel" />
    <local:MessageTemplateSelector x:Key="AgentView.MessageTemplateSelector" />

    <!-- State badge: colored per ToolState, pulsing while running. -->
    <Style x:Key="AgentView.ToolStateBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ToolCall.State, RelativeSource={RelativeSource AncestorType=local:ToolCallCard}}"
                         Value="Running">
                <Setter Property="Background" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.AccentBrushKey}}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="AgentViewRunningPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.7" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="AgentViewRunningPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ToolCall.State, RelativeSource={RelativeSource AncestorType=local:ToolCallCard}}"
                         Value="Success">
                <Setter Property="Background" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.SuccessBrushKey}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToolCall.State, RelativeSource={RelativeSource AncestorType=local:ToolCallCard}}"
                         Value="Failed">
                <Setter Property="Background" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.ErrorBrushKey}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ToolCall.State, RelativeSource={RelativeSource AncestorType=local:ToolCallCard}}"
                         Value="Cancelled">
                <Setter Property="Background" Value="#808080" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AgentView.ToolSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}}" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="AgentView.ToolSectionTextStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.MonospaceFontFamilyKey}}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.TextBrushKey}}" />
        <Setter Property="MaxHeight" Value="360" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style TargetType="local:ToolCallCard">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToolCallCard">
                    <Border x:Name="Card"
                            Background="{DynamicResource {x:Static local:AgentViewResourceKeys.SurfaceBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static local:AgentViewResourceKeys.BorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,3"
                            Padding="10,7">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle" Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Chevron" Text="▸" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static local:AgentViewResourceKeys.TextBrushKey}}"
                                               Text="{Binding ToolCall.ToolName, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource {x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}}"
                                               Text="{Binding ToolCall.Subtitle, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <Border Grid.Column="3" Style="{StaticResource AgentView.ToolStateBadgeStyle}">
                                        <TextBlock FontSize="11" Foreground="White"
                                                   Text="{Binding ToolCall.State, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>
                                </Grid>
                            </ToggleButton>
                            <StackPanel x:Name="Body" Visibility="Collapsed" Margin="0,4,0,0">
                                <TextBlock Text="Input" Style="{StaticResource AgentView.ToolSectionLabelStyle}"
                                           Visibility="{Binding ToolCall.Input, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AgentView.StringToVisibility}}" />
                                <Border CornerRadius="3" Padding="8,5"
                                        Background="{DynamicResource {x:Static local:AgentViewResourceKeys.SurfaceStrongBrushKey}}"
                                        Visibility="{Binding ToolCall.Input, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AgentView.StringToVisibility}}">
                                    <TextBox Style="{StaticResource AgentView.ToolSectionTextStyle}"
                                             Text="{Binding ToolCall.Input, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                </Border>
                                <TextBlock Text="Output" Style="{StaticResource AgentView.ToolSectionLabelStyle}"
                                           Visibility="{Binding ToolCall.Output, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AgentView.StringToVisibility}}" />
                                <Border CornerRadius="3" Padding="8,5"
                                        Background="{DynamicResource {x:Static local:AgentViewResourceKeys.SurfaceStrongBrushKey}}"
                                        Visibility="{Binding ToolCall.Output, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource AgentView.StringToVisibility}}">
                                    <TextBox Style="{StaticResource AgentView.ToolSectionTextStyle}"
                                             Text="{Binding ToolCall.Output, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="DisplayMode" Value="Hidden">
                            <Setter TargetName="Card" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DisplayMode" Value="Compact">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderToggle" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger Property="DisplayMode" Value="Expanded">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderToggle" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="DisplayMode" Value="Collapsible" />
                                <Condition SourceName="HeaderToggle" Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="Text" Value="▾" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:MarkdownViewer">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.TextBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MarkdownViewer">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AgentView.MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="local:AgentChatView">
        <Setter Property="Background" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.BackgroundBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static local:AgentViewResourceKeys.TextBrushKey}}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AgentChatView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsControl x:Name="PART_Items"
                                      ItemsSource="{TemplateBinding Messages}"
                                      ItemTemplateSelector="{StaticResource AgentView.MessageTemplateSelector}"
                                      Focusable="False"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                            <ItemsControl.Resources>

                                <DataTemplate x:Key="AgentView.UserMessageTemplate">
                                    <StackPanel Margin="60,4,12,4" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,2">
                                            <TextBlock Style="{StaticResource AgentView.MetaTextStyle}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource AgentView.RoleLabel}">
                                                        <Binding Path="RoleLabel" />
                                                        <Binding Path="Role" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource AgentView.MetaTextStyle}" Margin="6,0,0,0"
                                                       Text="{Binding Timestamp.LocalDateTime, StringFormat='HH:mm:ss'}"
                                                       Visibility="{Binding Options.ShowTimestamps, RelativeSource={RelativeSource AncestorType=local:AgentChatView}, Converter={StaticResource AgentView.BoolToVisibility}}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource {x:Static local:AgentViewResourceKeys.UserBubbleBrushKey}}"
                                                CornerRadius="4" Padding="12,8" MaxWidth="640" HorizontalAlignment="Right">
                                            <local:MarkdownViewer Foreground="{DynamicResource {x:Static local:AgentViewResourceKeys.UserBubbleTextBrushKey}}"
                                                                  Text="{Binding Content}"
                                                                  EnableMarkdown="{Binding Options.EnableMarkdown, RelativeSource={RelativeSource AncestorType=local:AgentChatView}}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate x:Key="AgentView.AssistantMessageTemplate">
                                    <StackPanel Margin="12,4,60,4">
                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                                            <TextBlock Style="{StaticResource AgentView.MetaTextStyle}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource AgentView.RoleLabel}">
                                                        <Binding Path="RoleLabel" />
                                                        <Binding Path="Role" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource AgentView.MetaTextStyle}" Margin="6,0,0,0"
                                                       Text="{Binding Timestamp.LocalDateTime, StringFormat='HH:mm:ss'}"
                                                       Visibility="{Binding Options.ShowTimestamps, RelativeSource={RelativeSource AncestorType=local:AgentChatView}, Converter={StaticResource AgentView.BoolToVisibility}}" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource {x:Static local:AgentViewResourceKeys.SurfaceBrushKey}}"
                                                BorderBrush="{DynamicResource {x:Static local:AgentViewResourceKeys.BorderBrushKey}}"
                                                BorderThickness="1" CornerRadius="4" Padding="12,8">
                                            <local:MarkdownViewer Text="{Binding Content}"
                                                                  EnableMarkdown="{Binding Options.EnableMarkdown, RelativeSource={RelativeSource AncestorType=local:AgentChatView}}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate x:Key="AgentView.SystemMessageTemplate">
                                    <StackPanel Margin="12,6" HorizontalAlignment="Center" MaxWidth="640">
                                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 TextWrapping="Wrap" TextAlignment="Center" FontStyle="Italic" FontSize="12"
                                                 Foreground="{DynamicResource {x:Static local:AgentViewResourceKeys.SubduedTextBrushKey}}"
                                                 Text="{Binding Content, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource AgentView.MetaTextStyle}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   Text="{Binding Timestamp.LocalDateTime, StringFormat='HH:mm:ss'}"
                                                   Visibility="{Binding Options.ShowTimestamps, RelativeSource={RelativeSource AncestorType=local:AgentChatView}, Converter={StaticResource AgentView.BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate x:Key="AgentView.ToolMessageTemplate">
                                    <StackPanel Margin="12,2,60,2">
                                        <ItemsControl ItemsSource="{Binding ToolCalls}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:ToolCallCard ToolCall="{Binding}"
                                                                        DisplayMode="{Binding Options.ToolCallDisplay, RelativeSource={RelativeSource AncestorType=local:AgentChatView}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>

                            </ItemsControl.Resources>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True" Focusable="False"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
